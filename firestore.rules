rules_version = '2';

// Each signed-in user can read and write only their own My trials list.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['trials', 'updated'])
        && request.resource.data.trials is list
        && request.resource.data.trials.size() <= 500;
    }
  }
}
